# Copy this file to .env and fill in real values for local development.
# NEVER commit the real .env file — only this .example template.
# These same variable names must also be set on Vercel:
# Project -> Settings -> Environment Variables (Production + Preview)

# GitHub Personal Access Token with Contents: Read & Write on your data repo
GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# GitHub username or organization that owns the data repository
GITHUB_OWNER="ANONIMCHR"

# Repository name containing users*.json / music*.json
GITHUB_REPO="database"

# Branch to read from and commit to (optional, defaults to "main")
GITHUB_BRANCH="main"
